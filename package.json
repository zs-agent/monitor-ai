{
  "name": "monitor-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=2048 next dev --port 3000",
    "build": "next build",
    "postbuild": "node scripts/postbuild.js",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "leaflet": "^1.9.4",
    "mermaid": "^12.1.0",
    "next": "15.5.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "nanoid": "^3.3.18",
    "source-map-js": "^1.2.2"
  }
