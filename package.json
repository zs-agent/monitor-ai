{
  "name": "monitor-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "postbuild": "node -e \"var fs=require('fs');['vendor-chunks'].forEach(function(d){var s='.next/server/'+d,t='.next/standalone/.next/server/'+d;if(fs.existsSync(s))fs.cpSync(s,t,{recursive:true,force:true})});var s='.next/static',t='.next/standalone/.next/static';if(fs.existsSync(s))fs.cpSync(s,t,{recursive:true,force:true});\"",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "lint": "next lint"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "leaflet": "^1.9.4",
    "next": "^14.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
