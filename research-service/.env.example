# research-service 配置模板。复制为 .env 后填值；.env 不入库。
# 环境变量优先级高于上游默认配置（gpt_researcher/config/config.py 读取同名变量）。

# ---------- LLM（国内直连 DeepSeek；也可换任意 OpenAI 兼容端点）----------
DEEPSEEK_API_KEY=
FAST_LLM=deepseek:deepseek-chat
SMART_LLM=deepseek:deepseek-chat
STRATEGIC_LLM=deepseek:deepseek-chat

# 备选：OpenAI 兼容网关（如公司内网/中转站）——
# FAST_LLM=openai:deepseek-chat
# SMART_LLM=openai:deepseek-chat
# STRATEGIC_LLM=openai:deepseek-chat
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com

# ---------- 检索器（逗号分隔，可混用）----------
# 免 key：openalex / arxiv / semantic_scholar / duckduckgo
#   注意 arxiv 有 ~3s 限流，并发子查询会大量 429 并导致"无上下文"，默认只开 openalex。
# 需 key：tavily（覆盖新闻与厂商页面最好）/ bocha（国内搜索）/ serper / exa
RETRIEVER=openalex
TAVILY_API_KEY=
BOCHA_API_KEY=
SEARX_URL=

# ---------- 研究与报告 ----------
LANGUAGE=chinese
TOTAL_WORDS=1500
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_URLS_TO_SCRAPE=5
# auto = 有 TYPESAFE_API_KEY 用 jev，否则退化为 keyword；keyword 不需要任何 embedding 服务
CONTEXT_FILTER=keyword
VERBOSE=false

# ---------- 服务 ----------
RESEARCH_HOST=127.0.0.1
RESEARCH_PORT=8000

# 常用检索失败后自动尝试国内公开来源；设为空可禁用（对照实验）。
RESEARCH_DOMESTIC_FALLBACK=modelscope,gitee
